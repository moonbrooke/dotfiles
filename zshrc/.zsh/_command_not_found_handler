# Command not found handler
command_not_found_handler() {
    local cmd="$1"

    local messages=(
        "🤷 \e[1;31m%s\e[0m? I don't know what it is."
        "🤷 Never heard of \e[1;31m%s\e[0m in my life."
        "🤔 \e[1;31m%s\e[0m? Pretty sure you just made that up."
        "🤔 Are you sure \e[1;31m%s\e[0m is a real command?"
        "⚠️ 404: \e[1;31m%s\e[0m command not found."
        "🤷 Nice try, but \e[1;31m%s\e[0m isn't in my vocabulary."
        "🤔 \e[1;31m%s\e[0m? Did your cat just walk across the keyboard?"
        "⚠️ Instructions unclear, \e[1;31m%s\e[0m isn't a thing."
        "🤔 \e[1;31m%s\e[0m? That's a typo and you know it."
        "🤷 I checked every line of PATH, and \e[1;31m%s\e[0m is nowhere in sight."
        "⚠️ \e[1;31m%s\e[0m: Command lost in the void."
    )

    local rand_num=$(od -An -N2 -i /dev/urandom | tr -d ' ')
    local idx=$(( (rand_num % ${#messages[@]}) + 1 ))

    printf "${messages[$idx]}\n" "$cmd" >&2
    return 127
}

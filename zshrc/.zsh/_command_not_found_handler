command_not_found_handler() {
    local cmd="$1"

    local messages=(
        "\e[1;31m%s\e[0m? I don't know what it is ¯\_(ツ)_/¯"
        "\e[1;31m%s\e[0m was blown up by \e[1;32mCreeper\e[0m"
        "Never heard of \e[1;31m%s\e[0m in my life."
        "\e[1;31m%s\e[0m blew up"
        "\e[1;31m%s\e[0m? Pretty sure you just made that up."
        "\e[1;31m%s\e[0m was killed by \e[1;33m[Intentional Game Design]\e[0m"
        "Are you sure \e[1;31m%s\e[0m is a real command?"
        "\e[1;31m%s\e[0m hit the ground too hard"
        "404: \e[1;31m%s\e[0m command not found."
        "\e[1;31m%s\e[0m went off with a bang"
    )

    local rand_num=$(od -An -N2 -i /dev/urandom | tr -d ' ')
    local idx=$(( (rand_num % ${#messages[@]}) + 1 ))

    printf "${messages[$idx]}\n" "$cmd" >&2
    return 127
}

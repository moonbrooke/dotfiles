{
    "custom/layout": {
        "exec": "hyprctl getoption general:layout | sed -n 's/.*str: dwindle.*/DWINDLE/p; s/.*str: master.*/MASTER/p; s/.*str: scrolling.*/SCROLLING/p; s/.*str: monocle.*/MONOCLE/p'",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "Current Layout: <span color='#9ece6a'><b>{}</b></span>"
    }
}

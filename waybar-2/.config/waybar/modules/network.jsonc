{
    "network": {
        "interval": 5,
        "format-wifi": "NET: {essid}",
        "format-ethernet": "ETH: {ifname}",
        "format-disconnected": "NET: OFF",
        "tooltip": false,
        // "on-click": "kitty --class floating_nmtui -e nmtui"
        "on-click": "foot -T floating_wlctl wlctl"
    }
}

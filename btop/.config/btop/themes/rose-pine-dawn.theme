# Theme: rose-pine-dawn (Rose Pine Dawn, light)
# Generated by ~/scripts/theme -- do not edit by hand.

# Main bg
theme[main_bg]="#faf4ed"

# Main text color
theme[main_fg]="#464261"

# Title color for boxes
theme[title]="#464261"

# Higlight color for keyboard shortcuts
theme[hi_fg]="#56949f"

# Background color of selected item in processes box
theme[selected_bg]="#dfdad9"

# Foreground color of selected item in processes box
theme[selected_fg]="#464261"

# Color of inactive/disabled text
theme[inactive_fg]="#9893a5"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#56949f"

# Cpu box outline color
theme[cpu_box]="#9893a5"

# Memory/disks box outline color
theme[mem_box]="#9893a5"

# Net up/down box outline color
theme[net_box]="#9893a5"

# Processes box outline color
theme[proc_box]="#9893a5"

# Box divider line and small boxes line color
theme[div_line]="#9893a5"

# Temperature graph colors
theme[temp_start]="#56949f"
theme[temp_mid]="#ea9d34"
theme[temp_end]="#b4637a"

# CPU graph colors
theme[cpu_start]="#56949f"
theme[cpu_mid]="#ea9d34"
theme[cpu_end]="#b4637a"

# Mem/Disk free meter
theme[free_start]="#56949f"
theme[free_mid]="#ea9d34"
theme[free_end]="#b4637a"

# Mem/Disk cached meter
theme[cached_start]="#56949f"
theme[cached_mid]="#ea9d34"
theme[cached_end]="#b4637a"

# Mem/Disk available meter
theme[available_start]="#56949f"
theme[available_mid]="#ea9d34"
theme[available_end]="#b4637a"

# Mem/Disk used meter
theme[used_start]="#56949f"
theme[used_mid]="#ea9d34"
theme[used_end]="#b4637a"

# Download graph colors
theme[download_start]="#56949f"
theme[download_mid]="#ea9d34"
theme[download_end]="#b4637a"

# Upload graph colors
theme[upload_start]="#56949f"
theme[upload_mid]="#ea9d34"
theme[upload_end]="#b4637a"

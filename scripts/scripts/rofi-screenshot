#!/usr/bin/env bash

# Screenshot menu: pick what to capture, then hand off to ~/scripts/screenshot

ROFI_THEME="$HOME/.config/rofi/config.rasi"

chosen=$(printf '%s\n' \
    "󰹑  Main Monitor Screenshot" \
    "󰹑  Secondary Monitor Screenshot" \
    "󱣴  Area Selection Screenshot" \
    "󱂬  Window Screenshot" \
    "󰨇  Full Screenshot" | \
    rofi -dmenu -i -p "Screenshot" -line-padding 4 \
    -hide-scrollbar -theme "$ROFI_THEME" \
    -theme-str 'window {width: 35%;}')

[ -z "$chosen" ] && exit

case "$chosen" in
    "󰹑  Main Monitor Screenshot") "$HOME/scripts/screenshot" main ;;
    "󰹑  Secondary Monitor Screenshot") "$HOME/scripts/screenshot" secondary ;;
    "󱣴  Area Selection Screenshot") "$HOME/scripts/screenshot" select ;;
    "󱂬  Window Screenshot") "$HOME/scripts/screenshot" window ;;
    "󰨇  Full Screenshot") "$HOME/scripts/screenshot" full ;;
esac

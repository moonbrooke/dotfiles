#!/usr/bin/env sh

# Monitor switcher

INTERNAL="eDP-1"
EXTERNAL="HDMI-A-1"
STATE_FILE="$HOME/.config/hypr/_monitor_state.lua"

if ! hyprctl monitors all | grep -q "$EXTERNAL"; then
    notify-send 'Settings' "External monitor (<b>$EXTERNAL</b>) not detected." -t 2500 -i dialog-error &
    echo "External monitor ($EXTERNAL) not detected."
    exit 1
fi

MODE=$(printf "Laptop Only\nExternal Only\nExtend\nMirror" | rofi -dmenu -i -p "Display Mode:" -theme-str "window {width: 400; border: 3px; border-color: #24283b;}")

case "$MODE" in
    "Laptop Only")
        cat > "$STATE_FILE.tmp" <<EOF
-- Generated by monitor-switch (Laptop Only). Do not edit by hand.
hl.monitor({
    output = "$INTERNAL",
    mode = "highrr",
    position = "0x0",
    scale = 1,
    disabled = false,
})
hl.monitor({
    output = "$EXTERNAL",
    disabled = true,
})
EOF
        ;;
    "External Only")
        cat > "$STATE_FILE.tmp" <<EOF
-- Generated by monitor-switch (External Only). Do not edit by hand.
hl.monitor({
    output = "$INTERNAL",
    disabled = true,
})
hl.monitor({
    output = "$EXTERNAL",
    mode = "2560x1440@75",
    position = "0x0",
    scale = 1.25,
    disabled = false,
})
EOF
        ;;
    "Extend")
        cat > "$STATE_FILE.tmp" <<EOF
-- Generated by monitor-switch (Extend). Do not edit by hand.
hl.monitor({
    output = "$INTERNAL",
    mode = "highrr",
    position = "0x0",
    scale = 1,
    disabled = false,
})
hl.monitor({
    output = "$EXTERNAL",
    mode = "2560x1440@75",
    position = "1920x0",
    scale = 1.25,
    disabled = false,
})
EOF
        ;;
    "Mirror")
        cat > "$STATE_FILE.tmp" <<EOF
-- Generated by monitor-switch (Mirror). Do not edit by hand.
-- NOTE: mirrored output must NOT set position, otherwise Hyprland reports
-- "monitor eDP-1 overlaps with other monitor". It is excluded from the layout.
-- Mode/scale must match the source (eDP-1 = 1920x1080, scale 1).
hl.monitor({
    output = "$INTERNAL",
    mode = "highrr",
    position = "0x0",
    scale = 1,
    disabled = false,
})
hl.monitor({
    output = "$EXTERNAL",
    mode = "1920x1080",
    scale = 1,
    mirror = "$INTERNAL",
    disabled = false,
})
EOF
        ;;
    *)
        exit 0
        ;;
esac

mv "$STATE_FILE.tmp" "$STATE_FILE" || exit 1
hyprctl reload || { notify-send 'Settings' "Display mode switch to <b>$MODE</b> failed." -t 2500 -i dialog-error & echo "hyprctl reload failed"; exit 1; }
notify-send 'Settings' "Display mode switched to <span color=\"#9ece6a\"><b>$MODE</b></span>" -t 2500 -i dialog-information &

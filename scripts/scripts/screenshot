#!/bin/bash

SAVE_DIR=~/Pictures/Screenshots

FILENAME="screenshot_$(date +%Y-%b-%d-%H-%M-%S)_grim.png"
FILEPATH="$SAVE_DIR/$FILENAME"

mkdir -p "$SAVE_DIR"

get_monitor() {
    hyprctl -j monitors | jq -r --arg role "$1" '
        sort_by(.x, .y)
        | if $role == "main" then .[0].name // empty
          else .[1].name // empty
          end'
}

if [[ "$1" == "full" ]]; then
    grim "$FILEPATH"
    TYPE="Full"
elif [[ "$1" == "select" ]]; then
    grim -g "$(slurp)" "$FILEPATH"
    TYPE="Area"
elif [[ "$1" == "window" ]]; then
    hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | grim -g - "$FILEPATH"
    TYPE="Window"
elif [[ "$1" == "main" || "$1" == "secondary" ]]; then
    MONITOR=$(get_monitor "$1")

    if [[ -z "$MONITOR" ]]; then
        notify-send -a "Screenshot" -i dialog-error "Screenshot failed" "No $1 monitor found." \
            -t 2500 --hint=string:x-dunst-stack-tag:screenshot &
        exit 1
    fi

    grim -o "$MONITOR" "$FILEPATH"
    if [[ "$1" == "main" ]]; then
        TYPE="Main Monitor"
    else
        TYPE="Secondary Monitor"
    fi
else
    echo "Usage: $0 {main|secondary|select|window|full}"
    exit 1
fi

notify-send -a "$TYPE Screenshot" -i $FILEPATH "$TYPE Screenshot" "Screenshot saved as <b>$FILENAME</b>" \
    -t 2500 --hint=string:x-dunst-stack-tag:screenshot &

#!/bin/sh
set -eu

# Bookmark categories are discovered automatically: every <name>.md file in
# this directory becomes a "<name>" category in the menu.
# Format of each file (one bookmark per line):
#   Label :: https://example.com
#   https://example.com
BOOKMARKS_DIR="${BOOKMARKS_DIR:-$HOME/notes/Bookmarks}"

# Rofi command
ROFI="rofi -dmenu -i -markup-rows -p 'Bookmarks' \
    -theme-str 'window {width: 40%;}'"

# Browsers
# Choose your browsers accordingly
EDGE="$(command -v microsoft-edge-stable || true)"
FIREFOX="$(command -v firefox || command -v firefox-esr || true)"
FALLBACK="$(command -v xdg-open || echo microsoft-edge-stable)"

# Browser used for every category unless overridden below.
DEFAULT_BROWSER="$EDGE"
[ -n "$DEFAULT_BROWSER" ] || DEFAULT_BROWSER="$FIREFOX"

# Optional per-category browser override. The variable name is
# BOOKMARKS_BROWSER_<CATEGORY>, uppercased with non-alphanumerics as "_".
# Example: to open the "work" category in Firefox, export
#   BOOKMARKS_BROWSER_WORK=firefox

# Seed the default categories on first run, but never recreate a category
# the user deleted.
mkdir -p "$BOOKMARKS_DIR"
set -- "$BOOKMARKS_DIR"/*.md
if [ ! -e "$1" ]; then
  cat >"$BOOKMARKS_DIR/personal.md" <<'EOF'
# personal
Twitter :: https://x.com
https://www.youtube.com
EOF
  cat >"$BOOKMARKS_DIR/linux.md" <<'EOF'
# linux
Hyprland Wiki :: https://wiki.hypr.land/
EOF
fi

emit() {
  tag="$1"; file="$2"
  [ -f "$file" ] || return 0
  # Output: "[tag] <display> :: <url or raw>"
  # We keep the whole line after '::' as the raw RHS, or the entire line if no '::'
  grep -vE '^\s*(#|$)' "$file" | while IFS= read -r line; do
    case "$line" in
      *"::"*)
        lhs="${line%%::*}"; rhs="${line#*::}"
        lhs="$(printf '%s' "$lhs" | sed 's/[[:space:]]*$//')"
        rhs="$(printf '%s' "$rhs" | sed 's/^[[:space:]]*//')"
        printf '%-10s %s :: %s\n' "[$tag]" "$lhs" "$rhs"
        ;;
      *)
        printf '%-10s %s :: %s\n' "[$tag]" "$line" "$line"
        ;;
    esac
  done
}

# Build combined list from every .md file in the bookmarks directory
list="$(
  for file in "$BOOKMARKS_DIR"/*.md; do
    [ -f "$file" ] || continue
    tag="${file##*/}"
    tag="${tag%.md}"
    emit "$tag" "$file"
  done | sort
)"

[ -n "$list" ] || exit 0

choice="$(printf '%s\n' "$list" \
  | sed -e 's/^\[\([^]]*\)\]/<span foreground="#565f89">[\1]<\/span>/' \
  | eval "$ROFI" || true)"

[ -n "$choice" ] || exit 0

# Strip Pango markup before parsing
choice="$(printf '%s' "$choice" | sed -e 's/<[^>]*>//g')"

# Parse tag and raw URL
tag="${choice%%]*}"; tag="${tag#\[}"
raw="${choice##* :: }"

# Strip inline comments and trim
raw="$(printf '%s' "$raw" \
  | sed -e 's/[[:space:]]\+#.*$//' -e 's/[[:space:]]\/\/.*$//' \
        -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

# Ensure scheme
case "$raw" in
  http://*|https://*|file://*|about:*|chrome:*) url="$raw" ;;
  *) url="https://$raw" ;;
esac

# Pick browser by tag (optional per-category override, else default)
uc_tag="$(printf '%s' "$tag" | tr -c '[:alnum:]\n' '_' | tr '[:lower:]' '[:upper:]')"
eval "browser=\${BOOKMARKS_BROWSER_${uc_tag}:-}"
[ -n "$browser" ] || browser="$DEFAULT_BROWSER"

open_with() {
  cmd="$1"
  if [ -n "$cmd" ]; then
    nohup "$cmd" --new-tab "$url" >/dev/null 2>&1 & exit 0
  fi
}

# Open with the chosen browser
open_with "$browser"

# Fallback if specific browser not found
nohup $FALLBACK "$url" >/dev/null 2>&1 &

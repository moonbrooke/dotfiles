#!/usr/bin/env bash

# shellcheck disable=SC1091
. "$HOME/scripts/themes/colors"

folder=$HOME/notes/

newnote () { \
  dir="$(find "$folder" -maxdepth 1 -type d ! -name ".git" | rofi -dmenu -i -l 11 -p 'Choose directory: ' -theme-str "window {width: 35%; border: 3px; border-color: $T_BG_ALT;}")" || exit 0
  : "${dir:=$folder}"
  
  name="$(echo "" | rofi -dmenu -theme-str 'window {width: 35%;} listview {lines: 0;}' -p "Enter a name: " <&-)" || exit 0
  : "${name:=$(date +%F_%H-%M-%S)}"
  
  setsid -f foot -e nvim "${dir%/}/$name.md" >/dev/null 2>&1
}

selected () { \
  choice=$(
    echo -e "✏️ New note...\n$(find "$folder" -name ".git" -prune -o -type f \( -name "*.md" -o -name "*.txt" \) -printf '%T@ %P\n' | sort -nr | cut -d' ' -f2-)" | rofi -dmenu -i -l 11 -p "Notes: " \
        -mesg "<span foreground='$T_FG_MUTED'>Select a note or write new one!</span>" \
        -theme-str 'window {width: 35%;}'
  )
  case $choice in
    "✏️ New note...") newnote ;;
    *.md|*.txt) setsid -f foot -e nvim "$folder$choice" >/dev/null 2>&1 ;;
    *) exit ;;
  esac
}

selected

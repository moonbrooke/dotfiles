# Theme: @@T_ID@@ (@@T_NAME@@, @@T_MODE@@)
# Generated by ~/scripts/theme -- do not edit by hand.

# Main bg
theme[main_bg]="@@T_BG@@"

# Main text color
theme[main_fg]="@@T_FG@@"

# Title color for boxes
theme[title]="@@T_FG@@"

# Higlight color for keyboard shortcuts
theme[hi_fg]="@@T_AQUA@@"

# Background color of selected item in processes box
theme[selected_bg]="@@T_SURFACE@@"

# Foreground color of selected item in processes box
theme[selected_fg]="@@T_FG@@"

# Color of inactive/disabled text
theme[inactive_fg]="@@T_FG_MUTED@@"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="@@T_AQUA@@"

# Cpu box outline color
theme[cpu_box]="@@T_FG_MUTED@@"

# Memory/disks box outline color
theme[mem_box]="@@T_FG_MUTED@@"

# Net up/down box outline color
theme[net_box]="@@T_FG_MUTED@@"

# Processes box outline color
theme[proc_box]="@@T_FG_MUTED@@"

# Box divider line and small boxes line color
theme[div_line]="@@T_FG_MUTED@@"

# Temperature graph colors
theme[temp_start]="@@T_GREEN@@"
theme[temp_mid]="@@T_YELLOW@@"
theme[temp_end]="@@T_RED@@"

# CPU graph colors
theme[cpu_start]="@@T_GREEN@@"
theme[cpu_mid]="@@T_YELLOW@@"
theme[cpu_end]="@@T_RED@@"

# Mem/Disk free meter
theme[free_start]="@@T_GREEN@@"
theme[free_mid]="@@T_YELLOW@@"
theme[free_end]="@@T_RED@@"

# Mem/Disk cached meter
theme[cached_start]="@@T_GREEN@@"
theme[cached_mid]="@@T_YELLOW@@"
theme[cached_end]="@@T_RED@@"

# Mem/Disk available meter
theme[available_start]="@@T_GREEN@@"
theme[available_mid]="@@T_YELLOW@@"
theme[available_end]="@@T_RED@@"

# Mem/Disk used meter
theme[used_start]="@@T_GREEN@@"
theme[used_mid]="@@T_YELLOW@@"
theme[used_end]="@@T_RED@@"

# Download graph colors
theme[download_start]="@@T_GREEN@@"
theme[download_mid]="@@T_YELLOW@@"
theme[download_end]="@@T_RED@@"

# Upload graph colors
theme[upload_start]="@@T_GREEN@@"
theme[upload_mid]="@@T_YELLOW@@"
theme[upload_end]="@@T_RED@@"

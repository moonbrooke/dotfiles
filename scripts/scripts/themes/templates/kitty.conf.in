# Generated by ~/scripts/theme (@@T_NAME@@, @@T_MODE@@) -- do not edit by hand.

# The basic colors
foreground              @@T_FG@@
background              @@T_BG@@
selection_foreground    @@T_BG@@
selection_background    @@T_PURPLE@@

# Cursor colors
cursor                  @@T_CURSOR@@
cursor_text_color       @@T_BG@@

# URL underline color when hovering with mouse
url_color               @@T_BLUE@@

# Kitty window border colors
active_border_color     @@T_CURSOR@@
inactive_border_color   @@T_SURFACE@@
bell_border_color       @@T_YELLOW@@

# Tab bar colors
active_tab_foreground   @@T_BG@@
active_tab_background   @@T_AQUA@@
inactive_tab_foreground @@T_FG_DIM@@
inactive_tab_background @@T_BG_ALT@@
tab_bar_background      none

# Custom tab bar
tab_title_template          "{fmt.fg._@@T_FG_MUTED_N@@}{fmt.bg._@@T_BG_N@@}{f'{title[:20]}...' if title.rindex(title[-1]) + 1 > 20 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}{' [󰍉]' if layout_name == 'stack' else ''} "
active_tab_title_template   "{fmt.fg._@@T_BLUE_N@@}{fmt.bg._@@T_BG_N@@}{f'{title[:20]}...' if title.rindex(title[-1]) + 1 > 20 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}{' [󰍉]' if layout_name == 'stack' else ''} "

# The 16 terminal colors

# black
color0 @@T_BG_ALT@@
color8 @@T_SURFACE@@

# red
color1 @@T_RED@@
color9 @@T_RED@@

# green
color2  @@T_GREEN@@
color10 @@T_GREEN@@

# yellow
color3  @@T_YELLOW@@
color11 @@T_YELLOW@@

# blue
color4  @@T_BLUE@@
color12 @@T_BLUE@@

# magenta
color5  @@T_PURPLE@@
color13 @@T_PURPLE@@

# cyan
color6  @@T_AQUA@@
color14 @@T_AQUA@@

# white
color7  @@T_FG_DIM@@
color15 @@T_FG@@

# Generated by ~/scripts/theme (@@T_NAME@@, @@T_MODE@@) -- do not edit by hand.

# The basic colors
foreground              @@T_FG_N@@
background              @@T_BG_N@@
selection_foreground    @@T_BG_N@@
selection_background    @@T_PURPLE_N@@

# Cursor colors
cursor                  @@T_CURSOR_N@@
cursor_text_color       @@T_BG_N@@

# URL underline color when hovering with mouse
url_color               @@T_BLUE_N@@

# Kitty window border colors
active_border_color     @@T_CURSOR_N@@
inactive_border_color   @@T_SURFACE_N@@
bell_border_color       @@T_YELLOW_N@@

# Tab bar colors
active_tab_foreground   @@T_BG_N@@
active_tab_background   @@T_AQUA_N@@
inactive_tab_foreground @@T_FG_DIM_N@@
inactive_tab_background @@T_BG_ALT_N@@
tab_bar_background      none

# Custom tab bar
tab_title_template          "{fmt.fg._@@T_SURFACE_N@@}{fmt.bg._@@T_BG_N@@}{f'{title[:20]}...' if title.rindex(title[-1]) + 1 > 20 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}{' [󰍉]' if layout_name == 'stack' else ''} "
active_tab_title_template   "{fmt.fg._@@T_AQUA_N@@}{fmt.bg._@@T_BG_N@@}{f'{title[:20]}...' if title.rindex(title[-1]) + 1 > 20 else (title.center(6) if (title.rindex(title[-1]) + 1) % 2 == 0 else title.center(5))}{' [󰍉]' if layout_name == 'stack' else ''} "

# The 16 terminal colors

# black
color0 @@T_BG_ALT_N@@
color8 @@T_SURFACE_N@@

# red
color1 @@T_RED_N@@
color9 @@T_RED_N@@

# green
color2  @@T_GREEN_N@@
color10 @@T_GREEN_N@@

# yellow
color3  @@T_YELLOW_N@@
color11 @@T_YELLOW_N@@

# blue
color4  @@T_BLUE_N@@
color12 @@T_BLUE_N@@

# magenta
color5  @@T_PURPLE_N@@
color13 @@T_PURPLE_N@@

# cyan
color6  @@T_AQUA_N@@
color14 @@T_AQUA_N@@

# white
color7  @@T_FG_DIM_N@@
color15 @@T_FG_N@@

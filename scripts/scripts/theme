#!/usr/bin/env bash
#
# ~/scripts/theme -- switch the desktop color theme.
#
#   theme                 open the rofi picker
#   theme menu            same as above
#   theme list            print every theme with a terminal color preview
#   theme set <name>      apply a theme, reload the desktop, and notify
#   theme apply [name]    apply silently (defaults to the current theme)
#   theme current         print the active theme id
#   theme names           print every theme id
#   theme --help
#
# Applying a theme regenerates the rofi/kitty/btop/waybar/hyprland colors,
# rewrites the foot/dunst/waybar-module colors in place, and then reloads the
# running components without logging out.

set -uo pipefail

THEMES_DIR="$HOME/scripts/themes"
# shellcheck disable=SC1091
. "$THEMES_DIR/lib.sh"

ROFI_THEME="$CONFIG_DIR/rofi/config.rasi"

# Start from the active palette so $T_* is always defined for the menu chrome.
theme_load "$(theme_current)"

hex_to_rgb() {
    local hex=${1#\#}
    printf '%s;%s;%s' "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

theme_swatch_terminal() {
    local c
    for c in "$T_BG" "$T_RED" "$T_YELLOW" "$T_GREEN" "$T_BLUE"; do
        printf '\033[48;2;%sm      \033[0m' "$(hex_to_rgb "$c")"
    done
}

menu() {
    local cur muted id label mark
    cur=$(theme_current)
    theme_load_quiet "$cur" || true
    muted="${T_FG_MUTED:-${T_FG_DIM:-}}"

    for id in "${THEME_IDS[@]}"; do
        theme_load_quiet "$id" || continue
        label=$T_NAME
        mark=""
        [ "$id" = "$cur" ] && mark=" <span color=\"$muted\">(Active)</span>"
        printf '%s%s\t%s\n' "$label" "$mark" "$(theme_swatch)"
    done
}

menu_rofi() {
    local chosen id
    chosen=$(menu | rofi -dmenu -markup-rows -format 'p' -i -no-custom \
        -p "Theme" -line-padding 4 -hide-scrollbar \
        -theme "$ROFI_THEME" \
        -theme-str "window {width: 40%; border: 3px; border-color: $T_BG_ALT;}")

    [ -z "$chosen" ] && return 0
    chosen=${chosen%%$'\t'*}
    chosen=$(printf '%s' "$chosen" \
        | sed -e 's/<[^>]*>//g' \
              -e 's/[[:space:]]*(Active)[[:space:]]*$//' \
              -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

    for id in "${THEME_IDS[@]}"; do
        theme_load_quiet "$id" || continue
        if [ "$T_NAME" = "$chosen" ]; then
            apply "$id"
            return 0
        fi
    done
}

list() {
    local cur id
    cur=$(theme_current)
    for id in "${THEME_IDS[@]}"; do
        theme_load "$id"
        printf '%-14s %s %s\n' "$id" "$(theme_swatch_terminal)" \
            "$([ "$id" = "$cur" ] && echo '*' || echo ' ')"
    done
}

apply() {
    local name=$1
    theme_apply "$name" || {
        log "theme: failed to apply '$name'"
        return 1
    }
    theme_reload
    theme_notify
    printf '%s\n' "$THEME_APPLIED_ID"
}

case "${1:-menu}" in
    menu | "")
        menu_rofi
        ;;
    list)
        list
        ;;
    set)
        [ -n "${2:-}" ] || die "usage: theme set <name>"
        apply "$2"
        ;;
    apply)
        theme_apply "${2:-$(theme_current)}"
        ;;
    current)
        theme_current
        printf '\n'
        ;;
    names)
        printf '%s\n' "${THEME_IDS[@]}"
        ;;
    -h | --help | help)
        sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "unknown command: $1 (try: theme list)"
        ;;
esac

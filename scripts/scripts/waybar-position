#!/usr/bin/env sh

set -eu

STATE_FILE="$HOME/.cache/waybar_state"
CONFIG_DIR="$HOME/.config/waybar"
TOP="$CONFIG_DIR/top.jsonc"
BOTTOM="$CONFIG_DIR/bottom.jsonc"
ISLAND_TOP="$CONFIG_DIR/island-top.jsonc"
ISLAND_BOTTOM="$CONFIG_DIR/island-bottom.jsonc"
LAUNCHER="$HOME/.config/hypr/scripts/launch-waybar.sh"

CURRENT=""
if [ -f "$STATE_FILE" ]; then
    CURRENT=$(tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || true)
fi

case "$CURRENT" in
    top|bottom|island-top|island-bottom) ;;
    *) CURRENT="top" ;;
esac

if [ "$CURRENT" = "top" ]; then
    NEW="bottom"
    TARGET="$BOTTOM"
elif [ "$CURRENT" = "bottom" ]; then
    NEW="island-top"
    TARGET="$ISLAND_TOP"
elif [ "$CURRENT" = "island-top" ]; then
    NEW="island-bottom"
    TARGET="$ISLAND_BOTTOM"
else
    NEW="top"
    TARGET="$TOP"
fi

if [ ! -f "$TARGET" ]; then
    notify-send 'Settings' "Waybar config not found: <b>$TARGET</b>" -t 2500 -i dialog-error &
    echo "Error: config not found: $TARGET" >&2
    exit 1
fi

printf '%s\n' "$NEW" > "$STATE_FILE"

echo "Waybar position set to: $NEW"

POS=$(printf '%s' "$NEW" | tr '[:lower:]' '[:upper:]')
notify-send 'Settings' "Waybar position set to <span color=\"#9ece6a\"><b>$POS</b></span>" -t 2500 -i dialog-information &

pkill waybar || true
sleep 0.5
if pgrep -x waybar >/dev/null 2>&1; then
    echo "Error: failed to stop old waybar instance" >&2
    exit 1
fi

if [ -x "$LAUNCHER" ]; then
    "$LAUNCHER" -c "$TARGET" >/dev/null 2>&1 &
else
    waybar -c "$TARGET" >/dev/null 2>&1 &
fi

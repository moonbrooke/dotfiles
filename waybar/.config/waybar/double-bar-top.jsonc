{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,

    "include": [
        "~/.config/waybar/modules/custom/*.jsonc",
        "~/.config/waybar/modules/hyprland/*.jsonc",
        "~/.config/waybar/modules/*.jsonc",
    ],
    
    "modules-left": [
        "custom/layout-double",
        "hyprland/window"
        // "hyprland/workspaces",
    ],
    "modules-center": [
        // "custom/weather",
        "clock#datetime"
    ],
    "modules-right": [
        "memory",
        "cpu",
        "temperature"
        // "custom/power"
    ]
}
